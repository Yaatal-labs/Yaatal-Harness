{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cargo build --release -p yaatal-api --bin yaatal_api-cli",
    "watchPatterns": [
      "railway.json",
      ".env.example",
      "Cargo.toml",
      "Cargo.lock",
      "crates/yaatal-api/**",
      "crates/yaatal-core/**",
      "crates/yaatal-feed/**",
      "crates/yaatal-search/**",
      "crates/yaatal-voice/**",
      "migrations/**",
      "scripts/run-rust-gates.ps1",
      "scripts/setup-rust-test-env.ps1"
    ]
  },
  "deploy": {
    "startCommand": "/app/target/release/yaatal_api-cli start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
