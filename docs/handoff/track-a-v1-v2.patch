+/// Operator approval for sending recorded audio out of the sovereign zone to
+/// HuggingFace's hosted inference API.
+///
+/// Recorded speech is Sovereign data and this endpoint's only backend is a
+/// third party. Nothing here can classify audio — `classify_data_class` reads
+/// text — so the endpoint refuses instead of guessing. Mirrors
+/// `BYO_SOVEREIGN_APPROVED` in the AI cascade, including its strictness: only
+/// ever true when the operator says so in as many letters. Any other value —
+/// "1", "yes", a typo — is not approval.
+///
+/// ponytail: a refusal, not a classifier. Ceiling — approval is per
+/// deployment, not per turn, so once it is set every caller's audio may leave.
+/// Upgrade path: V3-V5 of the voice plan replace this route with the on-device
+/// speech-core pipeline and delete the cloud branch, at which point this
+/// constant and its env var go with it.
+pub const CLOUD_TRANSCRIPTION_APPROVAL_ENV: &str = "VOICE_AUDIO_EXPORT_TO_HUGGINGFACE_APPROVED";
+
+fn cloud_transcription_approved() -> bool {
+    std::env::var(CLOUD_TRANSCRIPTION_APPROVAL_ENV)
+        .ok()
+        .filter(|value| !value.is_empty())
+        .is_some_and(|value| value.trim().eq_ignore_ascii_case("true"))
+}
+
 pub async fn transcribe(State(_ctx): State<AppContext>, body: Bytes) -> Result<Response> {
+    if !cloud_transcription_approved() {
+        tracing::warn!(
+            approval = CLOUD_TRANSCRIPTION_APPROVAL_ENV,
+            bytes = body.len(),
+            "refused cloud transcription: audio export is not approved"
+        );
+        return Ok((
+            StatusCode::SERVICE_UNAVAILABLE,
+            format!(
+                "transcription would send recorded audio to HuggingFace; \
+                 set {CLOUD_TRANSCRIPTION_APPROVAL_ENV}=true to approve that export"
+            ),
+        )
+            .into_response());
+    }
+
     let result = TranscriptionRouter::transcribe(&body, false)
         .await
         .map_err(|e| loco_rs::Error::string(&e.to_string()))?;
