# Keep the Docker build context small WITHOUT stripping source.
# Anchor root-only excludes with a leading `/` so a name like `data` or `bin`
# never matches a nested source module (e.g. crates/yaatal-api/src/data/,
# crates/yaatal-api/src/bin/). Do NOT use bare `**/bin` — it deletes the
# binary entry point.

# Big, regenerable, or non-source trees (anchored to repo root)
/target
/.git
/.worktrees
/.codex-branch-split-backup
/ml-intern
/notebooks
/artifacts
/output
/results
/data
/node_modules
/.netlify
/.vscode
/.agents
/.local-bin
/.local-reference

# Safe to match at any depth (no Rust source collides with these)
**/target/
**/.venv/
**/__pycache__/
**/node_modules/
**/.DS_Store
**/npm-debug.log
*.sqlite
*.sqlite3

# Env files (secrets are injected by Railway, never baked into the image)
.env
.env.*
!.env.example
