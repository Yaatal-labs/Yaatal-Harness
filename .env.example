# Yaatal Engine — Environment Variables
# Copy to .env and fill in values

# Railway / API deployment
DATABASE_URL=postgresql://postgres:password@host:5432/railway
APP_URL=https://your-service.up.railway.app

# Loco runtime
# Local workspace-root runs auto-detect crates/yaatal-api/config.
# Railway production runs are bootstrapped automatically by the API binary.
# LOCO_ENV=development
# LOCO_CONFIG_FOLDER=crates/yaatal-api/config

# Auth
JWT_SECRET=generate-a-secure-random-string
JWT_EXPIRATION_SECONDS=259200

# Optional SMTP
MAILER_STUB=true
SMTP_ENABLE=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

# AI Providers
SILICONFLOW_API_KEY=sk-your-siliconflow-key
HUGGINGFACE_API_KEY=hf_your-huggingface-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
OLLAMA_BASE_URL=http://localhost:11434

# Storage (S3-compatible)
S3_BUCKET=yaatal-storage
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=af-south-1

# Analytics
POSTHOG_API_KEY=phc_your-posthog-key

# Push Notifications
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-key

# Bo-Plex / voice-session orchestration
# Current milestone uses a local mock voice service first, then swaps to RunPod later.
VOICE_SERVICE_URL=ws://127.0.0.1:8082/session
SEARCH_SERVICE_URL=http://127.0.0.1:8081
SEARCH_SERVICE_TIMEOUT_SECONDS=5
VOICE_ROUTING_EDGE_PREFERRED_SECONDS=45
VOICE_ROUTING_CLOUD_DEFAULT_SECONDS=60
VOICE_ROUTING_ASR_CONFIDENCE_LOW=0.72
VOICE_ROUTING_INTENT_CONFIDENCE_LOW=0.68
VOICE_ROUTING_ENTITY_DENSITY_HIGH=6
VOICE_ROUTING_TOOL_COMPLEXITY_HIGH=3
VOICE_ROUTING_STICKY_CLOUD_TURNS=2
VOICE_ROUTING_DEBUG_MESSAGES=false

# Search service backend
SEARCH_BACKEND=in-memory
BGE_M3_URL=http://127.0.0.1:8090
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=yaatal-search
# QDRANT_API_KEY=replace-if-needed

# Legacy / engine-level Turso config
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token
