new file mode 100644
index 0000000..1d1fea8
--- /dev/null
+++ b/crates/yaatal-api/tests/requests/voice.rs
@@ -0,0 +1,147 @@
+//! End-to-end cover for `/api/voice/transcribe`.
+//!
+//! Recorded speech is Sovereign data and this endpoint's only backend is a
+//! third party (HuggingFace hosted inference). The test that matters is not
+//! "does it return an error" but "did the audio stay home" — so a mock stands
+//! in for HuggingFace and every case asserts what it did or did not receive.
+
+use loco_rs::testing::prelude::*;
+use serial_test::serial;
+use wiremock::matchers::{method, path};
+use wiremock::{Mock, MockServer, ResponseTemplate};
+use yaatal_api::app::App;
+use yaatal_api::controllers::voice::CLOUD_TRANSCRIPTION_APPROVAL_ENV;
+
+const HF_MODEL_PATH: &str = "/models/openai/whisper-large-v3";
+
+/// Saves the env keys a test touches and puts them back on drop, so the shared
+/// test process does not inherit them.
+struct EnvGuard(Vec<(&'static str, Option<String>)>);
+
+impl EnvGuard {
+    fn capture(keys: &[&'static str]) -> Self {
+        Self(
+            keys.iter()
+                .map(|key| (*key, std::env::var(key).ok()))
+                .collect(),
+        )
+    }
+}
+
+impl Drop for EnvGuard {
+    fn drop(&mut self) {
+        for (key, previous) in &self.0 {
+            match previous {
+                Some(value) => std::env::set_var(key, value),
+                None => std::env::remove_var(key),
+            }
+        }
+    }
+}
+
+/// A stand-in for the HuggingFace inference API that answers the whisper model
+/// path. Reachable — which is the point: if the endpoint sends anything, this
+/// records it.
+async fn huggingface_stub() -> MockServer {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path(HF_MODEL_PATH))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({
+            "text": "naka nga def"
+        })))
+        .mount(&server)
+        .await;
+    server
+}
+
+fn point_transcription_at(server: &MockServer) {
+    std::env::set_var("HF_INFERENCE_BASE_URL", server.uri());
+    std::env::set_var("HF_API_TOKEN", "test-token");
+}
+
+#[tokio::test]
+#[serial]
+async fn transcribe_refuses_and_sends_no_audio_without_operator_approval() {
+    let _guard = EnvGuard::capture(&[
+        CLOUD_TRANSCRIPTION_APPROVAL_ENV,
+        "HF_INFERENCE_BASE_URL",
+        "HF_API_TOKEN",
+    ]);
+    let server = huggingface_stub().await;
+    point_transcription_at(&server);
+    std::env::remove_var(CLOUD_TRANSCRIPTION_APPROVAL_ENV);
+
+    request::<App, _, _>(|request, _ctx| async move {
+        let response = request
+            .post("/api/voice/transcribe")
+            .text("pretend-this-is-a-wav")
+            .await;
+
+        assert_eq!(response.status_code(), 503, "body: {}", response.text());
+        assert!(
+            response.text().contains(CLOUD_TRANSCRIPTION_APPROVAL_ENV),
+            "the refusal must name the approval it wants: {}",
+            response.text()
+        );
+
+        // The assertion a status code cannot make: nothing left the Engine.
+        assert!(
+            server
+                .received_requests()
+                .await
+                .unwrap_or_default()
+                .is_empty(),
+            "audio reached the third party despite the refusal"
+        );
+    })
+    .await;
+}
+
+#[tokio::test]
+#[serial]
+async fn transcribe_reaches_huggingface_only_on_a_literal_true() {
+    let _guard = EnvGuard::capture(&[
+        CLOUD_TRANSCRIPTION_APPROVAL_ENV,
+        "HF_INFERENCE_BASE_URL",
+        "HF_API_TOKEN",
+    ]);
+    let server = huggingface_stub().await;
+    point_transcription_at(&server);
+
+    request::<App, _, _>(|request, _ctx| async move {
+        // Approval spelled out: the export happens. That proves the stub is
+        // reachable, so the refusal in the test above was the gate and not an
+        // unreachable URL.
+        std::env::set_var(CLOUD_TRANSCRIPTION_APPROVAL_ENV, "true");
+        let response = request
+            .post("/api/voice/transcribe")
+            .text("pretend-this-is-a-wav")
+            .await;
+        assert_eq!(response.status_code(), 200, "body: {}", response.text());
+        assert!(response.text().contains("naka nga def"));
+        assert_eq!(
+            server.received_requests().await.unwrap_or_default().len(),
+            1
+        );
+
+        // Near-misses are not approval.
+        for not_approval in ["yes", "1", "ture"] {
+            std::env::set_var(CLOUD_TRANSCRIPTION_APPROVAL_ENV, not_approval);
+            let response = request
+                .post("/api/voice/transcribe")
+                .text("pretend-this-is-a-wav")
+                .await;
+            assert_eq!(
+                response.status_code(),
+                503,
+                "{not_approval:?} must not read as approval"
+            );
+            assert_eq!(
+                server.received_requests().await.unwrap_or_default().len(),
+                1,
+                "{not_approval:?} let audio out"
+            );
+        }
+    })
+    .await;
+}
