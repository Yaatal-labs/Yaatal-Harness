{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "Dockerfile",
      ".dockerignore",
      "railway.json",
      "Cargo.toml",
      "Cargo.lock",
      "crates/**",
      "apps/**",
      "migrations/**"
    ]
  },
  "deploy": {
    "startCommand": "/app/yaatal_api-cli start --environment production",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
